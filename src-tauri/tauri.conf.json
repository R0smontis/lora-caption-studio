{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoRA Caption Studio",
  "version": "0.1.0",
  "identifier": "local.lora.captionstudio",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LoRA Caption Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "LoRA 图像数据集打标与修订工具",
    "longDescription": "支持多 API、多 Key 并发、标签生成、模型复核、批量文本编辑和版本恢复。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/onnxruntime/onnxruntime.dll",
      "resources/onnxruntime/onnxruntime_providers_cuda.dll",
      "resources/onnxruntime/onnxruntime_providers_shared.dll",
      "resources/cuda/cudart64_12.dll",
      "resources/cuda/cublas64_12.dll",
      "resources/cuda/cublasLt64_12.dll",
      "resources/cuda/cufft64_11.dll",
      "resources/cuda/cudnn64_9.dll",
      "resources/cuda/cudnn_adv64_9.dll",
      "resources/cuda/cudnn_cnn64_9.dll",
      "resources/cuda/cudnn_engines_precompiled64_9.dll",
      "resources/cuda/cudnn_engines_runtime_compiled64_9.dll",
      "resources/cuda/cudnn_graph64_9.dll",
      "resources/cuda/cudnn_heuristic64_9.dll",
      "resources/cuda/cudnn_ops64_9.dll"
    ]
  }
}